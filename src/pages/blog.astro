---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteData } from "../data/site";
---

<BaseLayout
  title="Blog — Syed Aashiq Ahamed"
  description="Writing about frontend systems, migrations, and lessons from production."
>
  <nav class="border-b border-border">
    <div class="container-narrow flex h-16 items-center px-6">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground"
        >← Back to portfolio</a
      >
    </div>
  </nav>
  <main class="section-padding">
    <div class="container-narrow">
      <div class="animate-fade-in-up">
        <div class="mb-2 flex items-center gap-3">
          <h1 class="font-display text-3xl font-bold text-foreground">
            Blog
          </h1><span
            class="rounded-full border border-primary/20 bg-primary/10 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-primary"
            >Launching soon</span
          >
        </div><p class="mb-12 max-w-lg text-muted-foreground">
          Writing about frontend systems, migrations, and lessons from
          production. First posts dropping soon.
        </p>
      </div><div class="space-y-4">
        {
          siteData.writing.posts.map((post) => (
            <article class="reveal rounded-lg border border-border bg-card p-6">
              <div class="flex items-start gap-3">
                <>
                  <span class="mt-0.5 text-primary" aria-hidden="true">
                    ▤
                  </span>
                  <div>
                    <>
                      <h2 class="mb-1 font-display font-semibold text-foreground">
                        {post.title}
                      </h2>
                      <p class="mb-3 text-sm text-muted-foreground">
                        {post.description}
                      </p>
                      <p class="flex items-center gap-1.5 font-mono text-xs text-muted-foreground">
                        ◷ Coming soon
                      </p>
                    </>
                  </div>
                </>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
