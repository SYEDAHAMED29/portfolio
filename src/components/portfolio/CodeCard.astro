---
// syed.ts tab content for the home page editor window (Workspace.astro).
import { Code } from "astro:components";
import { siteData } from "../../data/site";

const lineNumbers = Array.from(
  { length: siteData.codeCard.object.split("\n").length },
  (_, index) => index + 1,
);
---

<div class="code-card__scroll">
  <h2 class="sr-only">syed.ts</h2>
  <div class="code-card__content">
    <div class="code-card__line-numbers" aria-hidden="true">
      {lineNumbers.map((lineNumber) => <span>{lineNumber}</span>)}
    </div>
    <Code code={siteData.codeCard.object} lang="ts" theme="one-dark-pro" />
  </div>
</div>

<style>
  .code-card__scroll {
    overflow-x: auto;
  }

  /* Matches the .ide-code gutter in the other editor tabs. */
  .code-card__content {
    display: flex;
    min-width: max-content;
    padding: 1.25rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.875rem;
    line-height: 1.75;
  }

  .code-card__line-numbers {
    flex: 0 0 2rem;
    margin-right: 1rem;
    color: hsl(var(--code-comment));
    font-size: 0.75rem;
    text-align: right;
    user-select: none;
  }

  .code-card__line-numbers span {
    display: block;
    height: 1.53125rem; /* 0.875rem × 1.75 */
    line-height: 1.53125rem;
  }

  .code-card__content :global(.astro-code) {
    margin: 0;
    border: 0;
    border-radius: 0;
    padding: 0;
    overflow: visible;
    background: transparent !important;
    color: inherit;
    font: inherit;
    line-height: inherit;
  }

  .code-card__content :global(.astro-code code) {
    display: block;
    font: inherit;
    line-height: inherit;
  }
</style>
