---
import { siteData } from "../../data/site";
const lines = siteData.codeCard.object.split("\n");
---

<div
  class="glow-sm overflow-hidden rounded-lg border border-code-border bg-code-bg"
>
  <div class="flex items-center gap-2 border-b border-code-border px-4 py-2.5">
    <span class="h-3 w-3 rounded-full bg-destructive/60"></span><span
      class="h-3 w-3 rounded-full bg-primary/40"></span><span
      class="h-3 w-3 rounded-full bg-code-string/40"></span>
    <span class="ml-2 font-mono text-xs text-muted-foreground"
      >{siteData.codeCard.filename}</span
    >
  </div>
  <pre
    class="overflow-x-auto p-4 font-mono text-sm leading-relaxed"><code>{lines.map((line, index) => <span class="flex"><span class="mr-4 w-8 select-none text-right text-xs leading-relaxed text-code-comment">{index + 1}</span><span class="text-code-bracket">{line}</span></span>)}</code></pre>
</div>
