---
import { siteData } from "../../data/site";
---

<section id="contact" class="section-padding"><div class="container-narrow"><div class="reveal max-w-xl"><h2 class="mb-4 font-display text-3xl font-bold text-foreground lg:text-4xl">Get in Touch</h2><p class="mb-8 text-base text-muted-foreground lg:text-lg">{siteData.contact.closingLine}</p><div class="flex flex-wrap gap-3"><a href={`mailto:${siteData.email}`} data-analytics-event="email_clicked" data-analytics-location="contact" class="button-primary px-4 py-2.5 text-base">✉ <span>Email me</span></a><a href={siteData.linkedin} target="_blank" rel="noopener noreferrer" data-analytics-event="linkedin_clicked" data-analytics-location="contact" class="button-secondary px-4 py-2.5 text-base"><span aria-hidden="true">in</span><span>LinkedIn</span></a><a href={siteData.github} target="_blank" rel="noopener noreferrer" data-analytics-event="github_clicked" data-analytics-location="contact" class="button-secondary px-4 py-2.5 text-base"><span aria-hidden="true">GH</span><span>GitHub</span></a><a href={siteData.resumePath} target="_blank" rel="noopener noreferrer" data-analytics-event="resume_clicked" data-analytics-location="contact" class="button-secondary px-4 py-2.5 text-base">↓ <span>Resume</span></a></div></div></div></section>
