---
import { FileDown, Mail } from "@lucide/astro";
import { siteData } from "../../data/site";
import BrandIcon from "./BrandIcon.astro";
---

<section id="contact" class="section-padding"><div class="container-narrow"><div class="reveal max-w-xl"><h2 class="mb-4 font-display text-3xl font-bold text-foreground lg:text-4xl">Get in Touch</h2><p class="mb-8 text-base text-muted-foreground lg:text-lg">{siteData.contact.closingLine}</p><div class="flex flex-wrap gap-3"><a href={`mailto:${siteData.email}`} data-analytics-event="email_clicked" data-analytics-location="contact" class="button-primary px-4 py-2.5 text-base"><Mail size={16} stroke-width={2} aria-hidden="true" /><span>Email me</span></a><a href={siteData.linkedin} target="_blank" rel="noopener noreferrer" data-analytics-event="linkedin_clicked" data-analytics-location="contact" class="button-secondary px-4 py-2.5 text-base"><BrandIcon name="linkedin" size={16} /><span>LinkedIn</span></a><a href={siteData.github} target="_blank" rel="noopener noreferrer" data-analytics-event="github_clicked" data-analytics-location="contact" class="button-secondary px-4 py-2.5 text-base"><BrandIcon name="github" size={16} /><span>GitHub</span></a><a href={siteData.resumePath} target="_blank" rel="noopener noreferrer" data-analytics-event="resume_clicked" data-analytics-location="contact" class="button-secondary px-4 py-2.5 text-base"><FileDown size={16} stroke-width={2} aria-hidden="true" /><span>Resume</span></a></div></div></div></section>
