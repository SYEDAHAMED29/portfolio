---
import { siteData } from "../../data/site";

const experience = siteData.experience;
---

<section id="experience" class="section-padding">
  <div class="container-narrow">
    <h2
      class="reveal mb-10 font-display text-3xl font-bold text-foreground lg:text-4xl"
    >
      Experience
    </h2><div class="space-y-8">
      {
        experience.map((item) => (
          <article class="reveal rounded-lg border border-border bg-card p-6 transition-colors hover:border-primary/20">
            <>
              <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <>
                  <div class="flex items-start gap-3">
                    <>
                      <div class="mt-0.5 rounded-md bg-secondary p-1">
                        <div class="flex items-center gap-2">
                          {item.icons.map((src) => (
                            <img
                              src={src}
                              alt={`${item.company} logo`}
                              width="48"
                              height="48"
                              loading="lazy"
                              decoding="async"
                              class="h-4 w-4 object-contain sm:h-12 sm:w-12"
                            />
                          ))}
                        </div>
                      </div>
                      <div>
                        <>
                          <h3 class="font-display text-lg font-semibold text-foreground lg:text-xl">
                            {item.company}
                          </h3>
                          <p class="text-base text-muted-foreground">
                            {item.role}
                          </p>
                        </>
                      </div>
                    </>
                  </div>
                  <span class="whitespace-nowrap font-mono text-sm text-muted-foreground">
                    {item.period}
                  </span>
                </>
              </div>
              <ul class="mb-4 ml-11 space-y-2">
                {item.bullets.map((bullet) => (
                  <li class="flex gap-2 text-base leading-relaxed text-muted-foreground">
                    <span class="shrink-0 text-primary">•</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
              <div class="ml-11 flex flex-wrap gap-1.5">
                {item.stack.map((tech) => (
                  <span class="pill px-2 py-0.5 text-xs">{tech}</span>
                ))}
              </div>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>
