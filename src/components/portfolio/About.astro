---
import { siteData } from "../../data/site";

// Highlight the name inside the intro line.
const NAME = "Syed";
const [leadBefore, ...leadRest] = siteData.about.lead.split(NAME);
const leadAfter = leadRest.join(NAME);

const [mainPhoto, ...otherPhotos] = [
  {
    src: "/syed.jpg",
    file: "syed.jpg",
    alt: "Syed Aashiq Ahamed",
    width: 2164,
    height: 2321,
  },
  {
    src: "/syed-thrissur.jpeg",
    file: "thrissur.jpeg",
    alt: "Syed at Thrissur beach",
    width: 960,
    height: 1280,
  },
  {
    src: "/syed-varkala.jpeg",
    file: "varkala.jpeg",
    alt: "Syed at Varkala",
    width: 960,
    height: 1280,
  },
];
---

<div class="grid lg:grid-cols-[minmax(0,1fr)_17rem]">
  <div class="ide-code px-3 py-5 sm:px-5">
    <div class="ide-line">
      <h2 class="font-bold text-foreground">
        <span class="text-code-keyword" aria-hidden="true"># </span>About
      </h2>
    </div>
    <div class="ide-line"><span></span></div>
    <div class="ide-line">
      <p class="ide-lead">
        {leadBefore}
        {leadRest.length > 0 && <span class="text-primary">{NAME}</span>}
        {leadAfter}
      </p>
    </div>
    <div class="ide-line"><span></span></div>
    {
      siteData.about.body.map((paragraph, index) => (
        <>
          <div class="ide-line">
            {index === siteData.about.body.length - 1 ? (
              <p class="text-pill-foreground">
                <span class="text-code-string" aria-hidden="true">
                  {"> "}
                </span>
                <em>{paragraph}</em>
              </p>
            ) : (
              <p class="text-pill-foreground">{paragraph}</p>
            )}
          </div>
          <div class="ide-line">
            <span />
          </div>
        </>
      ))
    }
    <div class="ide-line">
      <span class="text-code-comment" aria-hidden="true"
        >![me](./{mainPhoto.file})<span class="ide-cursor"></span></span
      >
    </div>
  </div>

  <aside
    class="border-t border-code-border p-4 lg:border-t-0 lg:border-l"
    aria-label="Photos"
  >
    <p class="mb-3 font-mono text-xs text-muted-foreground">
      <span class="text-code-property">preview</span> · {mainPhoto.file}
    </p>
    <div class="grid grid-cols-3 gap-2 lg:grid-cols-2">
      <figure class="col-span-1 lg:col-span-2">
        <img
          src={mainPhoto.src}
          alt={mainPhoto.alt}
          width={mainPhoto.width}
          height={mainPhoto.height}
          loading="lazy"
          decoding="async"
          class="aspect-[4/5] w-full rounded border border-code-border object-cover object-[50%_25%] lg:aspect-square"
        />
      </figure>
      {
        otherPhotos.map((photo) => (
          <figure>
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
              class="aspect-[4/5] w-full rounded border border-code-border object-cover"
            />
            <figcaption class="mt-1 truncate font-mono text-[0.6875rem] text-muted-foreground">
              {photo.file}
            </figcaption>
          </figure>
        ))
      }
    </div>
  </aside>
</div>
