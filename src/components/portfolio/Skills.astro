---
import { siteData } from "../../data/site";

const { categories } = siteData.skills;
const last = (list: readonly unknown[], index: number) =>
  index === list.length - 1;
---

<div class="ide-code px-3 py-5 sm:px-5">
  <h2 class="sr-only">Skills</h2>
  <div class="ide-line">
    <span class="text-code-bracket" aria-hidden="true">{"{"}</span>
  </div>

  <div class="ide-line">
    <h3 class="pl-[2ch] font-normal">
      <span class="text-code-property"
        ><span aria-hidden="true">"</span>Toolkit<span aria-hidden="true"
          >"</span
        ></span
      ><span class="text-code-bracket" aria-hidden="true">{": {"}</span>
    </h3>
  </div>
  <dl class="contents">
    {
      categories.map((category, index) => (
        <div class="ide-line">
          <div class="ide-hang pl-[4ch]">
            <dt class="inline text-code-property">
              <span aria-hidden="true">"</span>
              {category.title}
              <span aria-hidden="true">"</span>
            </dt>
            <span class="text-code-bracket" aria-hidden="true">
              {": ["}
            </span>
            <dd class="inline">
              {category.items.map((item, i) => (
                <>
                  <span class="whitespace-nowrap text-foreground/90">
                    {item}
                    {!last(category.items, i) && (
                      <span class="text-code-bracket">,</span>
                    )}
                  </span>
                  {!last(category.items, i) && " "}
                </>
              ))}
            </dd>
            <span class="text-code-bracket" aria-hidden="true">
              ]{last(categories, index) ? "" : ","}
            </span>
          </div>
        </div>
      ))
    }
  </dl>
  <div class="ide-line">
    <span class="pl-[2ch] text-code-bracket" aria-hidden="true">{"}"}</span>
  </div>
  <div class="ide-line">
    <span class="text-code-bracket" aria-hidden="true"
      >{"}"}<span class="ide-cursor"></span></span
    >
  </div>
</div>
