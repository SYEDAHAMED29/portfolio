---
import { Monitor, Server, Wrench, Zap } from "@lucide/astro";
import { siteData } from "../../data/site";
---

<section id="skills" class="section-padding bg-card/50">
  <div class="container-narrow">
    <h2
      class="reveal mb-10 font-display text-3xl font-bold text-foreground lg:text-4xl"
    >
      Skills
    </h2><div class="mb-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        siteData.skills.categories.map((category) => (
          <article class="reveal rounded-lg border border-border bg-background p-5">
            <>
              <div class="mb-4 flex items-center gap-2.5">
                <>
                  <span class="text-primary" aria-hidden="true">
                    {category.icon === "Monitor" ? (
                      <Monitor size={20} stroke-width={2} />
                    ) : category.icon === "Server" ? (
                      <Server size={20} stroke-width={2} />
                    ) : (
                      <Wrench size={20} stroke-width={2} />
                    )}
                  </span>
                  <h3 class="font-display text-base font-semibold text-foreground">
                    {category.title}
                  </h3>
                </>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {category.items.map((item) => (
                  <span class="pill px-2 py-0.5 text-sm">{item}</span>
                ))}
              </div>
            </>
          </article>
        ))
      }
    </div><article
      class="reveal rounded-lg border border-border bg-background p-5"
    >
      <div class="mb-4 flex items-center gap-2.5">
        <Zap
          size={18}
          stroke-width={2}
          class="text-primary"
          aria-hidden="true"
        /><h3 class="font-display text-base font-semibold text-foreground">
          Known for
        </h3>
      </div><div class="grid gap-2 sm:grid-cols-2">
        {
          siteData.skills.knownFor.map((item) => (
            <p class="flex items-center gap-2 text-base text-muted-foreground">
              <span class="text-primary">→</span>
              {item}
            </p>
          ))
        }
      </div>
    </article>
  </div>
</section>
