---
/**
 * Inline emoji for blog posts. Announced properly by screen readers, wiggles
 * on hover, and plays its own little sound when clicked (if sound is on).
 *
 * Custom (site-drawn) emoji:  <Emoji name="party" label="party popper" />
 * Native emoji fallback:      <Emoji label="party popper">🎉</Emoji>
 */
import { emojiIcons, type EmojiName } from "./emoji-icons";

interface Props {
  label: string;
  name?: EmojiName;
}

const { label, name } = Astro.props;
const icon = name ? emojiIcons[name] : undefined;
---

<span
  class:list={["blog-emoji", { "blog-emoji-custom": icon }]}
  role="img"
  aria-label={label}
  data-emoji
  data-emoji-name={name}
  >{
    icon ? (
      <svg
        viewBox="0 0 32 32"
        aria-hidden="true"
        focusable="false"
        set:html={icon}
      />
    ) : (
      <slot />
    )
  }</span
>

<script>
  import { playEmojiSound } from "../../../lib/sound";

  for (const emoji of document.querySelectorAll<HTMLElement>("[data-emoji]")) {
    emoji.addEventListener("click", () => {
      playEmojiSound(emoji.dataset.emojiName);
      emoji.classList.remove("is-bouncing");
      // Force a reflow so the animation restarts on every click.
      void emoji.offsetWidth;
      emoji.classList.add("is-bouncing");
    });
  }
</script>

<style>
  .blog-emoji {
    display: inline-block;
    cursor: pointer;
    font-style: normal;
    line-height: 1;
    transform-origin: 50% 80%;
    user-select: none;
  }

  /* Custom emoji sit on the text baseline like a native emoji glyph. */
  .blog-emoji-custom svg {
    display: inline-block;
    width: 1.2em;
    height: 1.2em;
    vertical-align: -0.22em;
  }

  .blog-emoji:hover {
    animation: blog-emoji-wiggle 450ms ease-in-out;
  }

  .blog-emoji.is-bouncing {
    animation: blog-emoji-bounce 420ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes blog-emoji-wiggle {
    0%,
    100% {
      transform: rotate(0);
    }
    25% {
      transform: rotate(-14deg);
    }
    50% {
      transform: rotate(10deg);
    }
    75% {
      transform: rotate(-6deg);
    }
  }

  @keyframes blog-emoji-bounce {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.45) rotate(-8deg);
    }
    100% {
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-emoji:hover,
    .blog-emoji.is-bouncing {
      animation: none;
    }
  }
</style>
