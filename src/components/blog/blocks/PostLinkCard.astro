---
/**
 * A card linking to another blog post, using that post's own title and
 * description so the card never goes stale.
 *
 * <PostLinkCard slug="legacy-jsp-vs-tailwind" kicker="Read next" />
 */
import { getEntry } from "astro:content";

interface Props {
  slug: string;
  kicker?: string;
}

const { slug, kicker = "Related post" } = Astro.props;
const post = await getEntry("blog", slug);

if (!post) {
  throw new Error(`PostLinkCard: no blog post with slug "${slug}".`);
}
---

<a class="post-link-card" href={`/blog/${post.id}`}>
  <span class="post-link-kicker">{kicker}</span>
  <span class="post-link-title">{post.data.title}</span>
  <span class="post-link-description">{post.data.description}</span>
  <span class="post-link-arrow" aria-hidden="true">→</span>
</a>

<style>
  .post-link-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 1.75rem 0 2rem;
    border: 1px solid var(--blog-border-strong);
    border-radius: 0.75rem;
    background: var(--blog-surface);
    padding: 1.125rem 3.5rem 1.125rem 1.25rem;
    color: var(--blog-text);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      transform 150ms ease;
  }

  .post-link-card:hover {
    border-color: var(--blog-accent);
    transform: translateY(-2px);
  }

  .post-link-card:focus-visible {
    outline: 2px solid var(--blog-accent);
    outline-offset: 3px;
  }

  .post-link-kicker {
    color: var(--blog-accent);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .post-link-title {
    color: var(--blog-heading);
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .post-link-description {
    color: var(--blog-text-on-surface);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .post-link-arrow {
    position: absolute;
    top: 50%;
    right: 1.25rem;
    color: var(--blog-accent);
    font-size: 1.5rem;
    transform: translateY(-50%);
    transition: transform 150ms ease;
  }

  .post-link-card:hover .post-link-arrow {
    transform: translate(4px, -50%);
  }

  @media (prefers-reduced-motion: reduce) {
    .post-link-card,
    .post-link-arrow {
      transition: none;
    }
  }
</style>
