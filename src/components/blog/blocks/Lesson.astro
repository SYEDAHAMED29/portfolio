---
/** One card inside <Lessons>. `highlight` marks the most important lesson. */
import Emoji from "./Emoji.astro";

interface Props {
  title: string;
  highlight?: boolean;
}

const { title, highlight = false } = Astro.props;
---

<li class:list={["lesson", { "lesson-highlight": highlight }]}>
  {
    highlight && (
      <p class="lesson-badge">
        <Emoji name="bulb" label="light bulb" /> Most important lesson
      </p>
    )
  }
  <p class="lesson-title">{title}</p>
  <div class="lesson-body">
    <slot />
  </div>
</li>

<style>
  .lesson {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 1rem;
    margin: 0;
    border: 1px solid var(--blog-border-strong);
    border-radius: 0.75rem;
    background: var(--blog-surface);
    padding: 1.25rem 1.5rem 1.25rem 1.25rem;
    counter-increment: lesson;
  }

  .lesson::before {
    content: counter(lesson);
    display: grid;
    grid-row: span 3;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 50%;
    background: var(--blog-accent);
    color: hsl(var(--primary-foreground));
    font-family: "JetBrains Mono", monospace;
    font-size: 1rem;
    font-weight: 800;
  }

  .lesson-title,
  .lesson-badge,
  .lesson-body {
    grid-column: 2;
  }

  .lesson-title {
    margin: 0.3rem 0 0.5rem;
    color: var(--blog-text);
    font-family: "Space Grotesk", sans-serif;
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .lesson-body {
    color: var(--blog-text-on-surface);
    font-size: 1rem;
    line-height: 1.65;
  }

  .lesson-body :global(p) {
    margin: 0 0 0.75rem;
  }

  .lesson-body :global(p:last-child) {
    margin-bottom: 0;
  }

  /* The one that matters most */
  .lesson-highlight {
    border-color: var(--blog-heading);
    background:
      linear-gradient(135deg, hsl(255 90% 82% / 0.1), transparent 60%),
      var(--blog-surface);
  }

  .lesson-highlight::before {
    background: var(--blog-heading);
  }

  .lesson-badge {
    justify-self: start;
    margin: 0 0 0.25rem;
    border-radius: 999px;
    background: hsl(255 90% 82% / 0.15);
    color: var(--blog-heading);
    padding: 0.1875rem 0.625rem;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  @media (max-width: 30rem) {
    .lesson {
      grid-template-columns: minmax(0, 1fr);
      padding: 1.125rem;
    }

    .lesson::before {
      grid-row: auto;
      margin-bottom: 0.625rem;
    }

    .lesson-title,
    .lesson-badge,
    .lesson-body {
      grid-column: 1;
    }
  }
</style>
