---
interface Props {
  href: string;
  path?: string;
  lineLabel?: string;
}

const { href, path, lineLabel } = Astro.props;

function derivePath(value: string): string | undefined {
  try {
    const url = new URL(value);
    const segments = url.pathname.split("/").filter(Boolean);
    const blobIndex = segments.indexOf("blob");

    if (blobIndex < 0 || segments.length <= blobIndex + 2) {
      return undefined;
    }

    return segments
      .slice(blobIndex + 2)
      .map(decodeURIComponent)
      .join("/");
  } catch {
    return undefined;
  }
}

function deriveLineLabel(value: string): string | undefined {
  try {
    const fragment = new URL(value).hash.slice(1);
    const match = fragment.match(/^L(\d+)(?:-L?(\d+))?$/);

    if (!match) return undefined;

    return match[2] ? `L${match[1]}–${match[2]}` : `L${match[1]}`;
  } catch {
    return undefined;
  }
}

function normalizeLineLabel(value: string | undefined): string | undefined {
  if (!value) return undefined;

  const match = value.match(/^#?L(\d+)(?:-L?(\d+))?$/);
  return match?.[2]
    ? `L${match[1]}–${match[2]}`
    : match?.[1]
      ? `L${match[1]}`
      : value;
}

const displayPath = path ?? derivePath(href) ?? "View source on GitHub";
const displayLine = normalizeLineLabel(lineLabel) ?? deriveLineLabel(href);
const accessiblePath = path ?? derivePath(href) ?? "the linked source";
const lineDescription = displayLine ? `, ${displayLine}` : "";
const ariaLabel = `View ${accessiblePath}${lineDescription} on GitHub (opens in a new tab)`;
---

<a
  class="github-source-link"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  title={href}
>
  <svg
    class="github-source-link-icon"
    viewBox="0 0 16 16"
    width="14"
    height="14"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
    ></path>
  </svg>
  <span class="github-source-link-path">{displayPath}</span>
  {displayLine && <span class="github-source-link-line">{displayLine}</span>}
</a>

<style>
  .github-source-link {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
    margin: 0 0 -0.75rem;
    gap: 0.5rem;
    border: 1px solid var(--blog-border-strong);
    border-radius: 0.375rem;
    background: var(--blog-code-bg);
    padding: 0.375rem 0.5rem;
    color: var(--blog-text-on-surface);
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    line-height: 1.35;
    text-decoration: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease;
    vertical-align: middle;
  }

  .github-source-link:hover {
    border-color: var(--blog-accent);
    background: var(--blog-surface-subtle);
  }

  .github-source-link:focus-visible {
    outline: 2px solid var(--blog-accent);
    outline-offset: 3px;
  }

  .github-source-link-icon {
    flex-shrink: 0;
    color: var(--blog-text-muted);
  }

  .github-source-link:hover .github-source-link-icon {
    color: var(--blog-accent);
  }

  .github-source-link-path {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .github-source-link-line {
    flex-shrink: 0;
    color: var(--blog-accent-info);
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .github-source-link {
      width: 100%;
      align-items: flex-start;
      font-size: 0.6875rem;
    }

    .github-source-link-path {
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .github-source-link {
      transition: none;
    }
  }
</style>
