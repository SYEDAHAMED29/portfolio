---
/**
 * Light "app window" chrome shared by the blog's interactive demos.
 * Defines the demo palette as CSS custom properties, so anything rendered in
 * the default slot can use var(--demo-*). JSP is amber (the site accent), React is
 * violet (the article's heading colour), on soft warm greys.
 *
 * Scripts can change the address bar through [data-demo-url].
 */
interface Props {
  url: string;
}

const { url } = Astro.props;
---

<div class="demo-window">
  <div class="demo-bar" aria-hidden="true">
    <span class="demo-dot demo-dot-red"></span>
    <span class="demo-dot demo-dot-yellow"></span>
    <span class="demo-dot demo-dot-green"></span>
    <span class="demo-url" data-demo-url>{url}</span>
  </div>
  <div class="demo-body">
    <slot />
  </div>
</div>

<style>
  .demo-window {
    --demo-bg: #ffffff;
    --demo-surface: #f5f4f2;
    --demo-border: #ebe9e6;
    --demo-border-strong: #d9d5cf;
    --demo-text: #1c1917;
    --demo-muted: #78716c;
    --demo-jsp: #b45309;
    --demo-jsp-soft: #fdf4e7;
    --demo-jsp-line: #f2dfc0;
    --demo-react: #6d5bd0;
    --demo-react-soft: #f3f0ff;
    --demo-react-line: #ddd3fd;
    --demo-ease-pop: cubic-bezier(0.34, 1.56, 0.64, 1);

    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--demo-bg);
    box-shadow: 0 1.25rem 2.5rem -1rem rgb(0 0 0 / 0.6);
    color: var(--demo-text);
    font-family: var(--demo-font-ui);
    font-size: 1rem;
    line-height: 1.5;
  }

  .demo-bar {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    background: var(--demo-surface);
    padding: 0.625rem 0.875rem;
  }

  .demo-dot {
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 50%;
  }

  .demo-dot-red {
    background: #ff5f57;
  }

  .demo-dot-yellow {
    background: #febc2e;
  }

  .demo-dot-green {
    background: #28c840;
  }

  .demo-url {
    margin-inline: auto;
    border-radius: 0.25rem;
    background: var(--demo-bg);
    color: var(--demo-muted);
    padding: 0.125rem 0.75rem;
    font-family: var(--demo-font-ui);
    font-size: 0.75rem;
    transform: translateX(-1.25rem);
    transition: color 200ms ease;
  }

  .demo-body {
    position: relative;
  }
</style>
