---
/**
 * A whole React page, as an exploded view. The page is three layers:
 *   layout.jsp   the page frame (server, JSP)
 *   sidebar.jsp  the sidebar (server, JSP)
 *   index.html   React's build, which renders in the browser
 * Playing a route drops the layers in one by one, then snaps them flat into
 * one page. /login-page skips the JSP layers: only React lands, and it owns
 * the whole page. "Take apart" pulls the finished page back into layers.
 * Autoplays once when scrolled into view.
 */
const legend = [
  {
    key: "react",
    name: "index.html",
    note: "React · renders in the browser",
    tone: "react",
  },
  {
    key: "sidebar",
    name: "sidebar.jsp",
    note: "JSP · rendered on the server",
    tone: "jsp",
  },
  {
    key: "frame",
    name: "layout.jsp",
    note: "JSP · the page frame, on the server",
    tone: "jsp",
  },
];
---

<figure
  class="blog-figure layers-demo"
  data-layers-demo
  data-route="home"
  data-mode="flat"
>
  <div class="topbar">
    <div class="route-picker" role="group" aria-label="Choose a route">
      <span class="route-label">Request</span>
      <button
        type="button"
        class="route-option"
        data-route-option="home"
        aria-pressed="true">/overview</button
      >
      <button
        type="button"
        class="route-option"
        data-route-option="login"
        aria-pressed="false">/login-page</button
      >
    </div>
    <div class="actions">
      <button type="button" class="ghost" data-explode>Take apart</button>
      <button type="button" class="ghost" data-replay>↻ Replay</button>
    </div>
  </div>

  <div class="layout">
    <div class="scene" aria-hidden="true">
      <div class="stack" data-stack>
        <div class="layer layer-frame" data-layer="frame" data-state="landed">
          <div class="frame-header">
            <span class="frame-logo"></span>
            <i></i><i></i><i></i>
          </div>
          <span class="layer-tag tag-jsp">layout.jsp</span>
        </div>

        <div
          class="layer layer-sidebar"
          data-layer="sidebar"
          data-state="landed"
        >
          <div class="sidebar-region">
            <i class="is-active"></i><i></i><i></i><i></i><i></i>
          </div>
          <span class="layer-tag tag-jsp">sidebar.jsp</span>
        </div>

        <div class="layer layer-react" data-layer="react" data-state="landed">
          <div class="react-region">
            <div class="react-home">
              <span class="view-title">Dashboard</span>
              <div class="stats">
                <span><b>1.2k</b>users</span>
                <span><b>86</b>projects</span>
                <span><b>412</b>tasks</span>
              </div>
              <div class="bars">
                <i style="--h: 40%"></i><i style="--h: 65%"></i><i
                  style="--h: 50%"></i><i style="--h: 80%"></i><i
                  style="--h: 60%"></i><i style="--h: 92%"></i><i
                  style="--h: 74%"></i>
              </div>
            </div>
            <div class="react-login">
              <div class="login-card">
                <span class="view-title">Welcome back</span>
                <span class="field">you@company.com</span>
                <span class="field">••••••••</span>
                <span class="login-button">Log in</span>
              </div>
            </div>
          </div>
          <span class="layer-tag tag-react">index.html · React</span>
        </div>
      </div>
    </div>

    <ol class="legend" aria-hidden="true">
      {
        legend.map((item) => (
          <li class={`legend-item tone-${item.tone}`} data-legend={item.key}>
            <span class="legend-dot" />
            <span class="legend-text">
              <b>{item.name}</b>
              <small>{item.note}</small>
            </span>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="caption" data-caption aria-live="polite">
    One page: JSP around the edges, React inside.
  </p>

  <figcaption>
    The JSP only decides what surrounds React. Once <code>index.html</code> is on
    the page, React Router takes over.
  </figcaption>
</figure>

<script>
  import { playSound } from "../../../lib/sound";

  type Layer = "frame" | "sidebar" | "react";
  type Route = "home" | "login";
  type Step = {
    caption: string;
    landed: Layer[];
    mode: "exploded" | "flat";
  };

  const STEP_MS = 1150;
  const LAYERS: Layer[] = ["frame", "sidebar", "react"];

  const ROUTES: Record<
    Route,
    { url: string; skipped: Layer[]; steps: Step[]; apart: string }
  > = {
    home: {
      url: "/overview",
      skipped: [],
      apart:
        "Three layers: two from the JSP on the server, one from React in the browser.",
      steps: [
        {
          caption: "The browser requests <code>/overview</code>",
          landed: [],
          mode: "exploded",
        },
        {
          caption:
            "The Java app renders <code>layout.jsp</code>, the page frame",
          landed: ["frame"],
          mode: "exploded",
        },
        {
          caption: "…and includes <code>sidebar.jsp</code> for the sidebar",
          landed: ["frame", "sidebar"],
          mode: "exploded",
        },
        {
          caption:
            "<code>&lt;jsp:include&gt;</code> adds React’s <code>index.html</code>, and React renders the dashboard",
          landed: ["frame", "sidebar", "react"],
          mode: "exploded",
        },
        {
          caption: "One page: JSP around the edges, React inside.",
          landed: ["frame", "sidebar", "react"],
          mode: "flat",
        },
      ],
    },
    login: {
      url: "/login-page",
      skipped: ["frame", "sidebar"],
      apart: "Just one layer: React’s <code>index.html</code>. No JSP at all.",
      steps: [
        {
          caption: "The browser requests <code>/login-page</code>",
          landed: [],
          mode: "exploded",
        },
        {
          caption:
            "The Java app skips the JSP and returns React’s <code>index.html</code> as is",
          landed: ["react"],
          mode: "exploded",
        },
        {
          caption: "No JSP layers at all, so React owns the whole page.",
          landed: ["react"],
          mode: "flat",
        },
      ],
    },
  };

  const wait = (ms: number) =>
    new Promise((resolve) => window.setTimeout(resolve, ms));

  for (const demo of document.querySelectorAll<HTMLElement>(
    "[data-layers-demo]",
  )) {
    const caption = demo.querySelector<HTMLElement>("[data-caption]");
    const replay = demo.querySelector<HTMLButtonElement>("[data-replay]");
    const explode = demo.querySelector<HTMLButtonElement>("[data-explode]");
    const options = [
      ...demo.querySelectorAll<HTMLButtonElement>("[data-route-option]"),
    ];
    if (!caption || !replay || !explode) continue;

    let route: Route = "home";
    let run = 0;
    let touched = false;

    const render = (step: Step, announce = true) => {
      const { skipped } = ROUTES[route];
      demo.dataset.mode = step.mode;
      for (const key of LAYERS) {
        const state = skipped.includes(key)
          ? "skipped"
          : step.landed.includes(key)
            ? "landed"
            : "pending";
        demo
          .querySelectorAll<HTMLElement>(
            `[data-layer="${key}"], [data-legend="${key}"]`,
          )
          .forEach((el) => (el.dataset.state = state));
      }
      caption.innerHTML = step.caption;
      explode.textContent =
        step.mode === "flat" ? "Take apart" : "Put together";
      if (announce) playSound(step.mode === "flat" ? "pop" : "tick");
    };

    const setRoute = (next: Route) => {
      route = next;
      demo.dataset.route = next;
      options.forEach((option) =>
        option.setAttribute(
          "aria-pressed",
          String(option.dataset.routeOption === next),
        ),
      );
    };

    const finished = (): Step => {
      const steps = ROUTES[route].steps;
      return steps[steps.length - 1];
    };

    const play = async () => {
      const token = ++run;
      for (const [index, step] of ROUTES[route].steps.entries()) {
        if (token !== run) return;
        render(step, index > 0);
        await wait(STEP_MS);
      }
    };

    options.forEach((option) =>
      option.addEventListener("click", () => {
        touched = true;
        setRoute(option.dataset.routeOption as Route);
        void play();
      }),
    );

    replay.addEventListener("click", () => {
      touched = true;
      void play();
    });

    // Pull the finished page apart (or put it back) to inspect the layers.
    explode.addEventListener("click", () => {
      touched = true;
      run++;
      const done = finished();
      const apart = demo.dataset.mode === "flat";
      render(
        {
          caption: apart ? ROUTES[route].apart : done.caption,
          landed: done.landed,
          mode: apart ? "exploded" : "flat",
        },
        false,
      );
    });

    setRoute("home");
    render(finished(), false);

    const reduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    if (!reduced) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          observer.disconnect();
          window.setTimeout(() => {
            if (!touched) void play();
          }, 400);
        },
        { threshold: 0.5 },
      );
      observer.observe(demo);
    }
  }
</script>

<style>
  /* Top row */
  .topbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .route-picker,
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .route-label {
    color: var(--blog-text-muted);
    font-size: 0.875rem;
  }

  .route-option {
    border: 0;
    border-radius: 0.25rem;
    background: rgb(255 255 255 / 0.06);
    color: var(--blog-text-muted);
    cursor: pointer;
    padding: 0.25rem 0.75rem;
    font-size: 0.8125rem;
  }

  .route-option[aria-pressed="true"] {
    background: rgb(245 165 36 / 0.14);
    color: var(--blog-accent);
  }

  .ghost {
    border: 0;
    border-radius: 0.25rem;
    background: transparent;
    color: var(--blog-text-muted);
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    font-size: 0.8125rem;
  }

  .ghost:hover {
    color: var(--blog-text);
  }

  .route-option:focus-visible,
  .ghost:focus-visible {
    outline: 2px solid var(--blog-accent);
    outline-offset: 2px;
  }

  /* Scene + legend */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 13rem;
    align-items: center;
    gap: 1.5rem;
  }

  .scene {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 24rem;
    perspective: 1400px;
  }

  .stack {
    position: relative;
    width: min(100%, 27rem);
    aspect-ratio: 16 / 10;
    transform-style: preserve-3d;
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .layers-demo[data-mode="exploded"] .stack {
    transform: translateY(2.5rem) rotateX(56deg) rotateZ(-38deg) scale(0.78);
  }

  /* Layers */
  .layer {
    position: absolute;
    inset: 0;
    border-radius: 0.5rem;
    transition:
      transform 700ms cubic-bezier(0.34, 1.3, 0.64, 1),
      opacity 350ms ease,
      background-color 400ms ease,
      box-shadow 400ms ease;
  }

  .layer[data-state="pending"] {
    opacity: 0;
    transform: translateZ(17rem);
  }

  .layer[data-state="skipped"] {
    opacity: 0;
    transform: translateZ(-4rem);
  }

  /* Exploded: layers float apart; glass panes so empty space reads as a layer */
  .layers-demo[data-mode="exploded"] .layer {
    box-shadow: 0 1.5rem 2.5rem rgb(0 0 0 / 0.35);
  }

  .layers-demo[data-mode="exploded"] .layer-sidebar[data-state="landed"] {
    transform: translateZ(4.5rem);
  }

  .layers-demo[data-mode="exploded"] .layer-react[data-state="landed"] {
    transform: translateZ(9rem);
  }

  .layers-demo[data-route="login"][data-mode="exploded"]
    .layer-react[data-state="landed"] {
    transform: translateZ(0);
  }

  .layers-demo[data-mode="exploded"] .layer-sidebar,
  .layers-demo[data-mode="exploded"] .layer-react {
    background: rgb(255 255 255 / 0.08);
  }

  .layers-demo[data-mode="flat"] .layer {
    box-shadow: none;
  }

  .layers-demo[data-mode="flat"] .layer-frame {
    box-shadow: 0 1.25rem 2.5rem -1rem rgb(0 0 0 / 0.6);
  }

  /* layout.jsp: the page frame */
  .layer-frame {
    background: #fffaf3;
  }

  .frame-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 14%;
    border-radius: 0.5rem 0.5rem 0 0;
    background: #f6dfb8;
    padding: 0 4%;
  }

  .frame-logo {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 0.3125rem;
    background: #b45309;
  }

  .frame-header i {
    width: 2.25rem;
    height: 0.3125rem;
    border-radius: 0.125rem;
    background: #e9c48a;
  }

  .frame-header i:first-of-type {
    margin-left: auto;
  }

  /* sidebar.jsp */
  .sidebar-region {
    position: absolute;
    top: 14%;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 26%;
    border-radius: 0 0 0 0.5rem;
    background: #fbe9cf;
    padding: 1rem 0.75rem;
  }

  .sidebar-region i {
    height: 0.375rem;
    border-radius: 0.125rem;
    background: #efd2a5;
  }

  .sidebar-region i.is-active {
    background: #e9a14a;
  }

  /* index.html → React */
  .react-region {
    position: absolute;
    top: 14%;
    right: 0;
    bottom: 0;
    left: 26%;
    border-radius: 0 0 0.5rem;
    background: #f3f0ff;
    padding: 0.875rem 1rem;
    color: #1c1917;
  }

  .layers-demo[data-route="login"] .react-region {
    inset: 0;
    border-radius: 0.5rem;
  }

  .react-login,
  .layers-demo[data-route="login"] .react-home {
    display: none;
  }

  .layers-demo[data-route="login"] .react-login {
    display: grid;
    height: 100%;
    place-items: center;
  }

  .view-title {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.375rem;
  }

  .stats span {
    border-radius: 0.25rem;
    background: #fff;
    color: #78716c;
    padding: 0.25rem 0.375rem;
    font-size: 0.5625rem;
  }

  .stats b {
    display: block;
    color: #1c1917;
    font-size: 0.75rem;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 0.25rem;
    height: 3.5rem;
    margin-top: 0.5rem;
    border-radius: 0.25rem;
    background: #fff;
    padding: 0.375rem;
  }

  .bars i {
    flex: 1;
    height: var(--h);
    border-radius: 0.125rem 0.125rem 0 0;
    background: #8b7cf0;
  }

  .login-card {
    display: grid;
    gap: 0.375rem;
    width: min(70%, 12rem);
    border-radius: 0.375rem;
    background: #fff;
    padding: 0.75rem;
  }

  .field {
    border: 1px solid #d9d5cf;
    border-radius: 0.25rem;
    color: #a8a29e;
    padding: 0.1875rem 0.375rem;
    font-size: 0.625rem;
  }

  .login-button {
    border-radius: 0.25rem;
    background: #6d5bd0;
    color: #fff;
    padding: 0.25rem;
    font-size: 0.625rem;
    font-weight: 600;
    text-align: center;
  }

  /* Tags on each layer, only while exploded */
  .layer-tag {
    position: absolute;
    right: -0.5rem;
    bottom: -0.5rem;
    border-radius: 0.25rem;
    padding: 0.0625rem 0.4375rem;
    font-size: 0.6875rem;
    font-weight: 700;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .layers-demo[data-mode="exploded"] .layer[data-state="landed"] .layer-tag {
    opacity: 1;
  }

  .tag-jsp {
    background: #b45309;
    color: #fff;
  }

  .tag-react {
    background: #6d5bd0;
    color: #fff;
  }

  /* Legend */
  .legend {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legend-item {
    --tone: #f5a524;

    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin: 0;
    line-height: 1.35;
    opacity: 0.4;
    transition: opacity 300ms ease;
  }

  .legend-item.tone-react {
    --tone: #bca8fa;
  }

  .legend-item[data-state="landed"] {
    opacity: 1;
  }

  .legend-item[data-state="skipped"] {
    opacity: 0.3;
  }

  .legend-item[data-state="skipped"] b {
    text-decoration: line-through;
  }

  .legend-dot {
    width: 0.75rem;
    height: 0.75rem;
    flex-shrink: 0;
    margin-top: 0.3125rem;
    border-radius: 0.1875rem;
    background: var(--tone);
  }

  .legend-text {
    line-height: 1.35;
  }

  .legend-text b {
    display: block;
    color: var(--blog-text);
    font-size: 0.9375rem;
  }

  .legend-text small {
    display: block;
    margin-top: 0.125rem;
    color: var(--blog-text-muted);
    font-size: 0.8125rem;
  }

  .caption {
    min-height: 1.5em;
    margin: 0.75rem 0 0;
    color: var(--blog-text);
    font-size: 0.9375rem;
  }

  .caption :global(code) {
    font-size: 0.8125rem;
  }

  @media (max-width: 44rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }

    .scene {
      min-height: 21rem;
    }

    .layers-demo[data-mode="exploded"] .stack {
      transform: translateY(3.5rem) rotateX(56deg) rotateZ(-38deg) scale(0.68);
    }

    .legend {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.5rem;
    }

    .legend-text small {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack,
    .layer,
    .layer-tag,
    .legend-item {
      transition: none;
    }
  }
</style>
