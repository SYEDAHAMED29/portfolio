---
import type { CollectionEntry } from "astro:content";
import BlogMeta from "./BlogMeta.astro";

interface Props {
  post: CollectionEntry<"blog">;
  readingTime?: string;
  isDraft?: boolean;
  featured?: boolean;
}

const { post, readingTime, isDraft = false, featured = false } = Astro.props;
---

<article class:list={["blog-card", { "blog-card-featured": featured }]}>
  <div class="blog-card-heading">
    <p class="blog-category">{post.data.category}</p>
    {isDraft && <span class="blog-draft">Draft</span>}
  </div>
  <h2 class="blog-card-title">
    <a href={`/blog/${post.id}`}>{post.data.title}</a>
  </h2>
  <p class="blog-card-description">{post.data.description}</p>
  <div class="blog-card-footer">
    <BlogMeta
      publishedDate={post.data.publishedDate}
      updatedDate={post.data.updatedDate}
      readingTime={readingTime}
    />
    <ul class="blog-tags" aria-label="Tags">
      {post.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
</article>
